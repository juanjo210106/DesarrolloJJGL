<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ejercicio1.PerfilUsuario"
             Title="PerfilUsuario"
             BackgroundColor="#F9F9F9">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30">

            <Label Text="Mi Perfil"
                   FontSize="28"
                   TextColor="#333333"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   Margin="0,10,0,10"/>

            <Frame CornerRadius="75" 
                   HeightRequest="150" 
                   WidthRequest="150"
                   HorizontalOptions="Center"
                   Padding="0"
                   BorderColor="#00A3AD" 
                   IsClippedToBounds="True"
                   HasShadow="True">
                <Image Source="dotnet_bot.png" Aspect="AspectFill"/>
            </Frame>

            <VerticalStackLayout Spacing="5">
                <Label Text="Usuario Ejemplo" 
                       FontSize="22" 
                       FontAttributes="Bold"
                       TextColor="#333333"
                       x:Name="lblNombreUsuario"
                       HorizontalOptions="Center"/>

                <Label Text="usuario@email.com" 
                       FontSize="16" 
                       TextColor="#00A3AD"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <Button Text="Editar Perfil" 
                    BackgroundColor="#00A3AD"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"
                    Shadow="{Shadow Brush=Black, Offset='1,3', Opacity=0.2}"
                    HorizontalOptions="Center"
                    WidthRequest="200"/>

            <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10"/>

            <TableView Intent="Settings" BackgroundColor="Transparent">
                <TableRoot>
                    <TableSection Title="OPCIONES DE CUENTA">

                        <TextCell Text="Cambiar contraseña" 
                                  Detail="Actualiza tu clave de acceso"
                                  TextColor="#333333"
                                  DetailColor="Gray"/>

                        <SwitchCell Text="Notificaciones" On="True"/>

                        <TextCell Text="Cerrar sesión" 
                                  TextColor="#D32F2F"/>
                    </TableSection>
                </TableRoot>
            </TableView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>