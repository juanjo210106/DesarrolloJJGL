<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ejercicio3.AjustesPage"
             Title="Configuración"
             BackgroundColor="#F9F9F9">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25">

            <Label Text="Ajustes"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#333333"
                   Margin="0,0,0,10"/>

            <Frame CornerRadius="15" Padding="20" BorderColor="Transparent" BackgroundColor="White">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Modo Oscuro" FontAttributes="Bold" FontSize="16" TextColor="#333333"/>
                        <Label Text="Interfaz con colores oscuros" FontSize="12" TextColor="Gray"/>
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" OnColor="#00A3AD" ThumbColor="White"/>
                </Grid>
            </Frame>

            <Frame CornerRadius="15" Padding="20" BorderColor="Transparent" BackgroundColor="White">
                <VerticalStackLayout Spacing="20">

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Notificaciones" VerticalOptions="Center" FontSize="16" TextColor="#333333"/>
                        <Switch Grid.Column="1" IsToggled="True" OnColor="#00A3AD" ThumbColor="White"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#F0F0F0"/>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Sonido" VerticalOptions="Center" FontSize="16" TextColor="#333333"/>
                        <Switch Grid.Column="1" IsToggled="True" OnColor="#00A3AD" ThumbColor="White"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="15" Padding="20" HasShadow="True" BorderColor="Transparent" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Volumen" FontAttributes="Bold" FontSize="16" TextColor="#333333"/>
                        <Label Grid.Column="1" Text="50%" FontAttributes="Bold" FontSize="14" TextColor="#00A3AD"/>
                    </Grid>

                    <Slider Minimum="0"
                            Maximum="100"
                            Value="50"
                            MinimumTrackColor="#00A3AD"
                            MaximumTrackColor="#E0E0E0"
                            ThumbColor="#00A3AD"/>
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="15" Padding="20" HasShadow="True" BorderColor="Transparent" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Idioma" FontAttributes="Bold" FontSize="16" TextColor="#333333"/>

                    <Frame BackgroundColor="#F5F5F5" Padding="15,0" CornerRadius="10" BorderColor="Transparent" HeightRequest="50">
                        <Picker Title="Selecciona idioma" TextColor="#333333" TitleColor="Gray">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Español</x:String>
                                    <x:String>English</x:String>
                                    <x:String>Français</x:String>
                                    <x:String>Deutsch</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>